VIDEO_PORT=8091
VIDEO_HOST=127.0.0.1
VIDEO_JAVA_URL=http://127.0.0.1:8090/api
# 模型网关默认读取仓库根目录 runtime-data/model.properties；可用 VIDEO_MODEL_URL 单独覆盖。
# 视频规划与画面审核默认读取 runtime-data/model.properties 中的 VIDEO_LLM_URL、VIDEO_LLM_MODEL、VIDEO_LLM_KEY。
# 如需通过环境变量覆盖，设置下方地址和模型，并在本地配置 VIDEO_LLM_KEY。
# VIDEO_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VIDEO_LLM_MODEL=qwen3.8-flash
VIDEO_AGENT_MAX_ROUNDS=32
# 密钥仅保留在被忽略的本地配置中：
# VIDEO_SERVICE_KEY, VIDEO_LLM_KEY, DB_PASSWORD
DB_URL=jdbc:mysql://localhost:3306/cloud_gallery
DB_USERNAME=root
VIDEO_MAX_ASSET_BYTES=104857600
VIDEO_MAX_SECONDS=120
VIDEO_QUOTA_BYTES=1073741824
VIDEO_QUOTA_COUNT=50
VIDEO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Linux requires FFmpeg >=6, ffprobe and a Chinese font:
# VIDEO_FFMPEG=/usr/bin/ffmpeg
# VIDEO_FFPROBE=/usr/bin/ffprobe
# VIDEO_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional preinstalled Chromium instead of Hypit's managed browser:
# VIDEO_CHROME=/usr/bin/chromium
